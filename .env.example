# Copy to .env and fill in. .env is gitignored.
# Everything here has a default except API_KEY, so the app starts without a
# .env; the values below are what you change to make it useful or deployable.

# weatherapi.com key, read by src/core/config.py and used by GET /weather/{city}.
# Empty means that one endpoint answers 500; nothing else is affected.
API_KEY=

# Signs the JWTs issued by /auth/login and /auth/token (src/core/security.py).
# Leave it unset and an ephemeral key is generated per process, so every restart
# invalidates outstanding tokens and logged-in users are silently signed out --
# tolerable in dev, broken behind more than one worker or container.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Optional: token lifetime in minutes, read by src/core/security.py. Default 60.
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional: how long a city's weather is reused before weatherapi.com is called
# again, read by src/api/weather_router.py. Default 300.
# WEATHER_CACHE_TTL_SECONDS=300

# Optional: root log level applied by src/core/logging_config.py. Default INFO;
# DEBUG also surfaces SQLAlchemy and uvicorn internals.
# LOG_LEVEL=INFO

# Optional: overrides the local Postgres fallback in
# src/core/database/database_connect.py, and is also what Alembic connects with.
# docker compose sets this itself, pointing at the db service.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/internship-project

# Optional: consumed by docker-compose.yml only -- they configure the postgres
# container and are interpolated into the DATABASE_URL it passes to the app.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=internship-project
